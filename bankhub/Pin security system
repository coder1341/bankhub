{% extends 'base.html' %}

{% block content %}

<div class="row">

    <div class="col-md-4">
        <div class="card p-4 shadow">
            <h5>Wallet Balance</h5>
            <h2>₦{{ wallet.balance }}</h2>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card p-4 shadow">

            <h5>Quick Actions</h5>

            <a href="/deposit/" class="btn btn-success mb-2 w-100">Deposit</a>
            <a href="/withdraw/" class="btn btn-danger mb-2 w-100">Withdraw</a>
            <a href="/transfer/" class="btn btn-primary mb-2 w-100">Transfer</a>
            <a href="/history/" class="btn btn-dark w-100">View Transactions</a>

        </div>
    </div>

</div>

{% endblock %}